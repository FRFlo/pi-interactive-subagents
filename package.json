{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and focus native in-process pi sessions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "bun test test/test.test.ts",
    "test:integration": "bun test --max-concurrency=1 test/integration/native-session.test.ts test/integration/native-orchestration.e2e.test.ts",
    "test:e2e": "bun test --max-concurrency=1 test/integration/native-orchestration.e2e.test.ts",
    "test:e2e:real": "cross-env PI_E2E_REAL_MODEL=1 bun test --max-concurrency=1 test/integration/real-model.smoke.test.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.65.0",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@sinclair/typebox": "^0.34.49",
    "cross-env": "^10.1.0"
  }
}
